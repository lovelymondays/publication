{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,

    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "strict": false,

    "skipLibCheck": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "noEmit": true
  },

  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules"]
}
